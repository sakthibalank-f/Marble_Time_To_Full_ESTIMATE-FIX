#!/sbin/sh
# Generic installer stub: hands over to the root manager's own installer
# (KernelSU, APatch or Magisk).
umask 022
ui_print() { echo "$1"; }
OUTFD=$2
ZIPFILE=$3
mount /data 2>/dev/null
UTIL=
for u in /data/adb/ksu/util_functions.sh /data/adb/ap/util_functions.sh /data/adb/magisk/util_functions.sh; do
  [ -f "$u" ] && UTIL="$u" && break
done
if [ -z "$UTIL" ]; then
  ui_print "*****************************************"
  ui_print " Install this zip from the KernelSU,"
  ui_print " APatch or Magisk manager app."
  ui_print "*****************************************"
  exit 1
fi
. "$UTIL"
install_module
exit 0
